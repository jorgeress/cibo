# Copia este archivo a `.env` y ajusta los valores.
# `.env` esta en .gitignore y nunca debe subirse al repositorio.

# === Ollama (local) ===
# URL del servidor Ollama. Por defecto escucha en el puerto 11434.
OLLAMA_BASE_URL=http://localhost:11434

# Modelo que usara el cliente por defecto.
# Puede ser un modelo base (llama3.1:8b) o el modelo propio
# creado a partir de cibo-config.modelfile (cibo:latest).
MODEL_NAME=cibo:latest

# Directorio raiz de datos (conversaciones, documentos, base vectorial).
DATA_PATH=./data

# === APIs cloud (OPCIONALES) ===
# Solo necesarias si activas los agentes cloud en los modos
# "balanced" o "performance". En modo "paranoid" no se usan.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
